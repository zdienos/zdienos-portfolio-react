# zdienos.com — single-page app served by Apache/LiteSpeed (DirectAdmin)
# Deployed from the repo; edit public/.htaccess there, not on the server.

# Don't let Apache guess files (e.g. /resume serving resume.pdf)
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS. Behind Cloudflare the origin may see plain HTTP, so the
  # visitor's real scheme is read from X-Forwarded-Proto to avoid a loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # The deploy tool's bookkeeping file lists every file and hash; keep it private
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # Real files and folders are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route (/about, /project, /resume, …)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_mime.c>
  # The PWA manifest; without this Apache sends application/octet-stream
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Entry points must be revalidated so a new deploy shows up immediately.
  # Hashed files in /assets get their own long cache rule (assets/.htaccess).
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|service-worker\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
